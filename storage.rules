rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Elevated roles only come from the custom claim set by setUserRole / the Admin SDK.
    function isSuperAdmin() {
      // TAQ-25: same second-factor switch as firestore.rules (off unless mfa_required is set).
      return isSignedIn() && request.auth.token.get('role', '') == 'SuperAdmin'
        && (request.auth.token.get('mfa_required', false) != true
          || request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null);
    }

    // Platform Admin may list and remove public listing photos to moderate them. It has no
    // access to the private users/ folder (KYC documents, contracts, voice notes).
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'Admin';
    }

    function under10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Private files: KYC documents, contracts, voice notes. Never public.
    match /users/{uid}/{path=**} {
      allow read, delete: if isSelf(uid) || isSuperAdmin();
      allow create, update: if isSelf(uid)
        && under10MB()
        && request.resource.contentType.matches('image/.*|application/pdf|audio/.*');
    }

    // The listing behind a photo is live: its public /Properties doc exists, is published, is
    // vacant (the only status sanitizeForMarketplace gives a live listing), is not held by
    // moderation, and belongs to the owner in the photo's path. One Firestore read; a missing doc
    // is null, so a deleted listing is refused. A `moderation_hidden` stored as the string 'true'
    // counts as hidden, as in firestore.rules. The trigger also sets is_published == false on
    // rented, unpublished and held listings; the status check does not rely on that.
    function listingLive(ownerUid, propertyId) {
      let listing = firestore.get(/databases/(default)/documents/Properties/$(propertyId));
      return listing != null
        && listing.data.get('is_published', false) == true
        && listing.data.get('status', 'unavailable') == 'vacant'
        && !(listing.data.get('moderation_hidden', false) in [true, 'true'])
        && listing.data.get('owner_id', '') == ownerUid;
    }

    // PropertyModeration/{propertyId} holds the listing hidden. A missing doc means not hidden.
    function moderationHeld(propertyId) {
      let moderation = firestore.get(/databases/(default)/documents/PropertyModeration/$(propertyId));
      return moderation != null && moderation.data.get('hidden', false) in [true, 'true'];
    }

    // Public listing photos, under the owner's uid and the property id.
    //  - get (download, metadata, getDownloadURL): the owner, SuperAdmin and Admin always; anyone
    //    else only while the listing is live (listingLive). Download URLs that carry a token are
    //    bearer links served without these rules, so a URL issued while a listing was live keeps
    //    working until its token is revoked.
    //  - list: the owner, SuperAdmin, and Admin (who lists photos to moderate them, TAQ-91), so
    //    file names of unpublished properties are not enumerable by anyone else.
    //  - create/update: the owner, under a property in their private Users/{ownerUid}/properties
    //    tree, and not while moderation holds the listing hidden.
    //  - delete: SuperAdmin, Admin, or the owner of an existing private property (held or not).
    // Each rule reads at most two Firestore documents (the Storage limit per evaluation). Cross-service
    // rules need the Storage service agent to have Firestore read access in the deployed project.
    match /public/listings/{ownerUid}/{propertyId}/{fileName} {
      allow get: if isSelf(ownerUid) || isSuperAdmin() || isAdmin() || listingLive(ownerUid, propertyId);
      allow list: if isSelf(ownerUid) || isSuperAdmin() || isAdmin();
      allow create, update: if isSelf(ownerUid)
        && under10MB()
        && request.resource.contentType.matches('image/(png|jpe?g|webp|gif)')
        && firestore.exists(/databases/(default)/documents/Users/$(ownerUid)/properties/$(propertyId))
        && !moderationHeld(propertyId);
      allow delete: if isSuperAdmin() || isAdmin()
        || (isSelf(ownerUid)
          && firestore.exists(/databases/(default)/documents/Users/$(ownerUid)/properties/$(propertyId)));
    }

    // Everything else is denied by default.
  }
}
