rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roles a user may pick for themselves at signup; the profile can vouch for these only.
    // Admin, AgencyAdmin and SuperAdmin come from custom claims set by setUserRole.
    function selfServiceRoles() {
      return ['Owner', 'Tenant', 'Investor'];
    }

    function claimedRole() {
      return request.auth.token.get('role', '');
    }

    function profileRole() {
      let path = /databases/$(database)/documents/Users/$(request.auth.uid);
      return exists(path) ? get(path).data.get('role', '') : '';
    }

    // Elevated roles (SuperAdmin, AgencyAdmin) only come from a custom claim set by
    // the setUserRole callable or the Admin SDK. The profile document can only vouch
    // for self-service roles, so a role written into Users/{uid} never escalates.
    function currentRole() {
      return claimedRole() != ''
        ? claimedRole()
        : (profileRole() in selfServiceRoles() ? profileRole() : '');
    }

    function hasRole(role) {
      return isAuthenticated() && currentRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('SuperAdmin');
    }

    function isAgencyAdmin() {
      return hasRole('AgencyAdmin');
    }

    // Platform Admin: moderates listings and handles escalations. Everything it may do is
    // listed explicitly below; it has no access to Users documents (IBAN, national ID), leases,
    // invoices, agency private data, roles or settings.
    function isAdmin() {
      return hasRole('Admin');
    }

    function isPlatformStaff() {
      return isSuperAdmin() || isAdmin();
    }

    function isOwner() {
      return hasRole('Owner');
    }

    function isTenant() {
      return hasRole('Tenant');
    }

    function myAgencyId() {
      return request.auth.token.get('agency_id', '');
    }

    function isAgencyAdminOf(agencyId) {
      return isAgencyAdmin() && myAgencyId() != '' && agencyId == myAgencyId();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function addedOrChangedKeys() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // 1. Users Collection
    // Fields only the server (Admin SDK / setUserRole) may write. `role` is handled separately.
    function lockedUserFields() {
      return [
        'agency_id', 'agencyId', 'verified', 'isVerified', 'is_verified', 'status', 'isSuperAdmin',
        'customClaims', 'claims', 'phone_verified', 'phoneVerified', 'isPhoneVerified',
        'email_verified', 'emailVerified', 'kycStatus', 'kyc_status', 'kyc_verified', 'kycVerified',
        'account_status', 'accountStatus', 'Role', 'role_updated_by', 'role_updated_at', 'plan'
      ];
    }

    function selfUserCreate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'Owner') in selfServiceRoles()
        && !request.resource.data.keys().hasAny(lockedUserFields());
    }

    // A self-service role may be set once, only while the profile has none.
    function selfRoleChangeOk() {
      return !changedKeys().hasAny(['role'])
        || (resource.data.get('role', '') == ''
          && request.resource.data.get('role', '') in selfServiceRoles());
    }

    function selfUserUpdate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && !changedKeys().hasAny(lockedUserFields())
        && selfRoleChangeOk();
    }

    // True when a private property write brings an image ref (imageUrls or image) that the doc
    // did not hold before. A value of the wrong type counts as new.
    function privateImagesAdded() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let urls = after.get('imageUrls', []);
      let image = after.get('image', '');
      let oldUrls = before.get('imageUrls', []);
      let known = (oldUrls is list ? oldUrls : []).concat([before.get('image', '')]).toSet();
      return !(urls is list) || !(image is string)
        || urls.toSet().difference(known).size() > 0
        || (image != '' && !(image in known));
    }

    match /Users/{userId} {
      // Profiles hold national ID and bank details, so they are private to their owner.
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isSuperAdmin() || selfUserCreate(userId);
      allow update: if isSuperAdmin() || selfUserUpdate(userId);
      allow delete: if isSuperAdmin();

      // Dedicated Owner Properties Tree (Users/{userId}/properties/{propertyId})
      match /properties/{propertyId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        // Investors do not list properties, so they cannot create the private drafts that
        // listing photos and the marketplace sync hang off.
        // While moderation holds the listing hidden the owner cannot add image refs (the same
        // block storage.rules puts on photo uploads), so lifting the hold cannot publish photos
        // nobody reviewed. Removing refs and every other edit stay allowed.
        // Property ids are global (TAQ-110): an id registered to another owner in PropertyOwners
        // cannot be created here, and `id_conflict` (set by the server on a colliding doc) is never
        // written or cleared by a client, SuperAdmin included.
        allow create: if propertyIdFreeFor(propertyId, userId)
          && !('id_conflict' in request.resource.data)
          && (isSuperAdmin()
            || (isAuthenticated() && request.auth.uid == userId && !hasRole('Investor')
              && (!privateImagesAdded() || !listingModerationHidden(propertyId))));
        allow update: if !changedKeys().hasAny(['id_conflict', 'id_conflict_at'])
          && (isSuperAdmin()
            || (isAuthenticated() && request.auth.uid == userId && !hasRole('Investor')
              && (!privateImagesAdded() || !listingModerationHidden(propertyId))));
        allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId && !hasRole('Investor'));
      }

      // Written by Cloud Functions only.
      // The recipient may only flip `read` (TAQ-110); content, ids and timestamps stay server-owned.
      match /notifications/{notificationId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow update: if isAuthenticated() && request.auth.uid == userId
          && changedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // 2. Properties Collection (Public Marketplace)
    // The only fields a public listing may carry. Must match sanitizeForMarketplace in
    // backend/index.js (plus agency_id attribution); anything else is rejected, so contact
    // fields such as phone, whatsapp, or email can never be written directly.
    function publicListingFields() {
      return [
        'id', 'owner_id', 'agency_id', 'countryCode', 'currencyCode',
        'titles', 'descriptions', 'locations', 'cityCode', 'propertyTypeCode', 'buildingName',
        'pricePerMonth', 'bedrooms', 'bathrooms', 'areaSqM', 'image', 'imageUrls',
        'amenitiesMap', 'isFurnished', 'agencyNames', 'agencyPhone', 'rating', 'isFeatured',
        'is_published', 'status', 'updated_at', 'verified', 'moderation_hidden'
      ];
    }

    function localizedKeysOk(data, field) {
      return !(field in data) || (data[field] is map && data[field].keys().hasOnly(['ar', 'en', 'hi']));
    }

    // Mirrors stripContacts() in backend/contact_filter.js. Rejects text that holds a phone number, a
    // messaging/social link or @handle, or an email address once obvious obfuscation is looked
    // through. Phone shapes (trunk zero, bare EG/UAE mobiles, country codes, +/00 prefixes;
    // digits of any script; O/l/I between digits; grouped digits) and the link patterns are
    // defined in backend/contact_patterns.js and the block below is generated from it: run
    // `npm run gen:contact-rules` in backend/. Runs of separators are collapsed to one `~`
    // first, and 1-2 digit groups are joined to their neighbours for a second check.
    // Prices, areas and dates stay free: 15000000, 15,000,000, 1.500.000.000, 2026-01-15.
    // BEGIN GENERATED contact patterns
    function contactPhone(text) {
      let t = text
        .replace('[\\x{fe0e}\\x{fe0f}\\x{20e3}\\x{200d}]', '')
        .replace('[\\x{a7}\\x{a6}\\x{a4}\\x{b6}\\x{60}\\x{b4}]', '~')
        .replace('[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]*[\\x{2c}\\x{66c}\\x{ff0c}][\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+', '§')
        .replace('[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+[\\x{7c}\\x{ff5c}][\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+', '§')
        .replace('(^|[^\\p{N}\\x{2c}\\x{66c}\\x{ff0c}]|[^\\p{N}][\\x{2c}\\x{66c}\\x{ff0c}])([1١۱߁१১੧૧୧௧౧೧൧෧๑໑༡၁១᠑１𝟏𝟙𝟣𝟭𝟷₁①⓵❶➀➊¹2٢۲߂२২੨૨୨௨౨೨൨෨๒໒༢၂២᠒２𝟐𝟚𝟤𝟮𝟸₂②⓶❷➁➋²3٣۳߃३৩੩૩୩௩౩೩൩෩๓໓༣၃៣᠓３𝟑𝟛𝟥𝟯𝟹₃③⓷❸➂➌³4٤۴߄४৪੪૪୪௪౪೪൪෪๔໔༤၄៤᠔４𝟒𝟜𝟦𝟰𝟺₄④⓸❹➃➍⁴5٥۵߅५৫੫૫୫௫౫೫൫෫๕໕༥၅៥᠕５𝟓𝟝𝟧𝟱𝟻₅⑤⓹❺➄➎⁵6٦۶߆६৬੬૬୬௬౬೬൬෬๖໖༦၆៦᠖６𝟔𝟞𝟨𝟲𝟼₆⑥⓺❻➅➏⁶7٧۷߇७৭੭૭୭௭౭೭൭෭๗໗༧၇៧᠗７𝟕𝟟𝟩𝟳𝟽₇⑦⓻❼➆➐⁷8٨۸߈८৮੮૮୮௮౮೮൮෮๘໘༨၈៨᠘８𝟖𝟠𝟪𝟴𝟾₈⑧⓼❽➇➑⁸9٩۹߉९৯੯૯୯௯౯೯൯෯๙໙༩၉៩᠙９𝟗𝟡𝟫𝟵𝟿₉⑨⓽❾➈➒⁹](?:\\p{N}{0,2}(?:[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{3})+|\\p{N}?(?:[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{2})+[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{3}))([^\\p{N}\\x{2c}\\x{66c}\\x{ff0c}]|[\\x{2c}\\x{66c}\\x{ff0c}][^\\p{N}]|[\\x{2c}\\x{66c}\\x{ff0c}]$|$)', '$1§$2§$3')
        .replace('(^|[^\\p{N}\\x{2c}\\x{66c}\\x{ff0c}]|[^\\p{N}][\\x{2c}\\x{66c}\\x{ff0c}])([1١۱߁१১੧૧୧௧౧೧൧෧๑໑༡၁១᠑１𝟏𝟙𝟣𝟭𝟷₁①⓵❶➀➊¹2٢۲߂२২੨૨୨௨౨೨൨෨๒໒༢၂២᠒２𝟐𝟚𝟤𝟮𝟸₂②⓶❷➁➋²3٣۳߃३৩੩૩୩௩౩೩൩෩๓໓༣၃៣᠓３𝟑𝟛𝟥𝟯𝟹₃③⓷❸➂➌³4٤۴߄४৪੪૪୪௪౪೪൪෪๔໔༤၄៤᠔４𝟒𝟜𝟦𝟰𝟺₄④⓸❹➃➍⁴5٥۵߅५৫੫૫୫௫౫೫൫෫๕໕༥၅៥᠕５𝟓𝟝𝟧𝟱𝟻₅⑤⓹❺➄➎⁵6٦۶߆६৬੬૬୬௬౬೬൬෬๖໖༦၆៦᠖６𝟔𝟞𝟨𝟲𝟼₆⑥⓺❻➅➏⁶7٧۷߇७৭੭૭୭௭౭೭൭෭๗໗༧၇៧᠗７𝟕𝟟𝟩𝟳𝟽₇⑦⓻❼➆➐⁷8٨۸߈८৮੮૮୮௮౮೮൮෮๘໘༨၈៨᠘８𝟖𝟠𝟪𝟴𝟾₈⑧⓼❽➇➑⁸9٩۹߉९৯੯૯୯௯౯೯൯෯๙໙༩၉៩᠙９𝟗𝟡𝟫𝟵𝟿₉⑨⓽❾➈➒⁹](?:\\p{N}{0,2}(?:[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{3})+|\\p{N}?(?:[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{2})+[\\x{2c}\\x{66c}\\x{ff0c}]\\p{N}{3}))([^\\p{N}\\x{2c}\\x{66c}\\x{ff0c}]|[\\x{2c}\\x{66c}\\x{ff0c}][^\\p{N}]|[\\x{2c}\\x{66c}\\x{ff0c}]$|$)', '$1§$2§$3')
        .replace('[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+[xX\\x{d7}][\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+', ' ')
        .replace('(\\p{N})[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]*[\\x{2b}\\x{ff0b}]', '$1~')
        .replace('(\\p{N})[A-HJ-NP-Za-km-np-z](\\p{N})', '$1~$2')
        .replace('[\\x{20}\\x{9}-\\x{d}\\x{a0}\\x{ad}\\x{61c}\\x{1680}\\x{180e}\\x{2000}-\\x{200f}\\x{2028}\\x{2029}\\x{202a}-\\x{202f}\\x{205f}\\x{2060}-\\x{2064}\\x{2066}-\\x{206f}\\x{3000}\\x{feff}\\x{2e}\\x{2d}\\x{2f}\\x{5f}\\x{5c}\\x{28}\\x{29}\\x{7e}\\x{2010}-\\x{2015}\\x{2212}\\x{fe63}\\x{2c}\\x{7c}\\x{3a}\\x{2a}\\x{23}\\x{27}\\x{b7}\\x{2022}\\x{66b}\\x{66c}\\x{3b}\\x{3d}\\x{5e}\\x{21}\\x{26}\\x{25}\\x{24}\\x{22}\\x{5b}\\x{5d}\\x{7b}\\x{7d}\\x{3c}\\x{3e}\\x{3f}\\x{aa}\\x{ba}\\x{ff0d}\\x{ff0e}\\x{ff0f}\\x{ff3f}\\x{ff3c}\\x{ff08}\\x{ff09}\\x{ff0c}\\x{ff1a}\\x{ff5c}]+', '~')
        .replace('(\\p{Nd})~?[\\p{No}\\p{Nl}]{1,6}~?(\\p{Nd})|(\\p{N})[^\\p{L}\\p{N}§]{1,6}', '$1$3~$2')
        .replace('(\\p{Nd})~?[\\p{No}\\p{Nl}]{1,6}~?(\\p{Nd})|(\\p{N})[^\\p{L}\\p{N}§]{1,6}', '$1$3~$2');
      let m = t
        .replace('(^~?|[^~\\p{N}]~?)(\\p{N}{1,2})~(\\p{N}{3}(?:[^\\p{N}]|$))', '$1$2¦$3')
        .replace('(^|[^\\p{N}¤])(\\p{N}{1,2})([^\\p{N}]|$)', '$1¤$2$3')
        .replace('(^|[^\\p{N}¤])(\\p{N}{1,2})([^\\p{N}]|$)', '$1¤$2$3')
        .replace('~?¤(\\p{N}{1,2})~?', '$1');
