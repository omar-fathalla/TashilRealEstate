rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function selfServiceRoles() {
      return ['Owner', 'Tenant'];
    }

    function claimedRole() {
      return request.auth.token.get('role', '');
    }

    function profileRole() {
      let path = /databases/$(database)/documents/Users/$(request.auth.uid);
      return exists(path) ? get(path).data.get('role', '') : '';
    }

    // Elevated roles (SuperAdmin, AgencyAdmin) only come from a custom claim set by
    // the setUserRole callable or the Admin SDK. The profile document can only vouch
    // for self-service roles, so a role written into Users/{uid} never escalates.
    function currentRole() {
      return claimedRole() != ''
        ? claimedRole()
        : (profileRole() in selfServiceRoles() ? profileRole() : '');
    }

    function hasRole(role) {
      return isAuthenticated() && currentRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('SuperAdmin');
    }

    function isAgencyAdmin() {
      return hasRole('AgencyAdmin');
    }

    function isOwner() {
      return hasRole('Owner');
    }

    function isTenant() {
      return hasRole('Tenant');
    }

    function myAgencyId() {
      return request.auth.token.get('agency_id', '');
    }

    function isAgencyAdminOf(agencyId) {
      return isAgencyAdmin() && myAgencyId() != '' && agencyId == myAgencyId();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function addedOrChangedKeys() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // 1. Users Collection
    // Fields only the server (Admin SDK / setUserRole) may write. `role` is handled separately.
    function lockedUserFields() {
      return [
        'agency_id', 'agencyId', 'verified', 'isVerified', 'is_verified', 'status', 'isSuperAdmin',
        'customClaims', 'claims', 'phone_verified', 'phoneVerified', 'isPhoneVerified',
        'email_verified', 'emailVerified', 'kycStatus', 'kyc_status', 'kyc_verified', 'kycVerified',
        'account_status', 'accountStatus', 'Role', 'role_updated_by', 'role_updated_at', 'plan'
      ];
    }

    function selfUserCreate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'Owner') in selfServiceRoles()
        && !request.resource.data.keys().hasAny(lockedUserFields());
    }

    // A self-service role may be set once, only while the profile has none.
    function selfRoleChangeOk() {
      return !changedKeys().hasAny(['role'])
        || (resource.data.get('role', '') == ''
          && request.resource.data.get('role', '') in selfServiceRoles());
    }

    function selfUserUpdate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && !changedKeys().hasAny(lockedUserFields())
        && selfRoleChangeOk();
    }

    match /Users/{userId} {
      // Profiles hold national ID and bank details, so they are private to their owner.
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isSuperAdmin() || selfUserCreate(userId);
      allow update: if isSuperAdmin() || selfUserUpdate(userId);
      allow delete: if isSuperAdmin();

      // Dedicated Owner Properties Tree (Users/{userId}/properties/{propertyId})
      match /properties/{propertyId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      }

      // Written by Cloud Functions only.
      match /notifications/{notificationId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow write: if false;
      }
    }

    // 2. Properties Collection (Public Marketplace)
    // The only fields a public listing may carry. Must match sanitizeForMarketplace in
    // backend/index.js (plus agency_id attribution); anything else is rejected, so contact
    // fields such as phone, whatsapp, or email can never be written directly.
    function publicListingFields() {
      return [
        'id', 'owner_id', 'agency_id', 'countryCode', 'currencyCode',
        'titles', 'descriptions', 'locations', 'cityCode', 'propertyTypeCode', 'buildingName',
        'pricePerMonth', 'bedrooms', 'bathrooms', 'areaSqM', 'image', 'imageUrls',
        'amenitiesMap', 'isFurnished', 'agencyNames', 'agencyPhone', 'rating', 'isFeatured',
        'is_published', 'status', 'updated_at'
      ];
    }

    function localizedKeysOk(data, field) {
      return !(field in data) || (data[field] is map && data[field].keys().hasOnly(['ar', 'en', 'hi']));
    }

    // Mirrors stripContacts() in backend/index.js. Rejects text that holds a phone number or
    // an email address once obvious obfuscation is looked through:
    //  - a run of 10+ digits (Latin, Arabic-Indic, Persian, full-width, or the letter O for
    //    zero) with at most two separator characters between digits, or
    //  - a + or a leading zero followed by 9+ digits, or
    //  - an email where @ may be written [at], (at), {at} or full-width, with spaces around it.
    // Prices and areas stay free: a run of 8 digits such as 15000000 is not a contact.
    // `(?s)` lets `.` span newlines, so a number on a later line is still found.
    function contactFree(text) {
      let digit = '[0-9٠-٩۰-۹０-９OoＯｏ]';
      let zero = '[0٠۰０]';
      let sep = '[ .()/_\\\\\\-\\x{00A0}\\x{2000}-\\x{200F}\\x{202F}\\x{2060}\\x{3000}\\x{2010}-\\x{2015}\\x{2212}\\x{FEFF}\\x{FF08}\\x{FF09}\\x{FF0D}\\x{FF0E}\\x{FF0F}\\x{FF3F}]{0,2}';
      let local = '[A-Za-z0-9._%+Ａ-Ｚａ-ｚ０-９-]';
      let ws = '[\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*';
      let at = ws + '([@＠﹫]|[\\[({]' + ws + '[Aa][Tt]' + ws + '[\\])}])' + ws;
      let dot = '([.．]|' + ws + '[\\[({]' + ws + '[Dd][Oo][Tt]' + ws + '[\\])}]' + ws + ')';
      let label = '[A-Za-z0-9Ａ-Ｚａ-ｚ０-９-]+';
      return !text.matches('(?s)^.*(' + digit + sep + '){10,}.*$')
        && !text.matches('(?s)^.*[+]' + sep + '(' + digit + sep + '){9,}.*$')
        && !text.matches('(?s)^(.*[^0-9٠-٩۰-۹０-９])?' + zero + sep + '(' + digit + sep + '){8,}.*$')
        && !text.matches('(?s)^.*' + local + at + label + '(' + dot + label + ')*' + dot + '[A-Za-zＡ-Ｚａ-ｚ]{2,}.*$');
    }

    function inRange(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    // Space-separated image references: download URLs from this project's Storage bucket
    // (outside private folders), bundled assets, or inline raster images. Must match
    // isPublicImageRef() in backend/index.js.
    function imageRefsOk(refs) {
      return refs.matches('^((https://firebasestorage[.]googleapis[.]com/v0/b/tashil-proptech-os[.](firebasestorage[.]app|appspot[.]com)/o/[^?# ]+([?][^# ]*)?|https://storage[.]googleapis[.]com/tashil-proptech-os[.](firebasestorage[.]app|appspot[.]com)/[^?# ]+|assets/[A-Za-z0-9_/.-]+[.](png|jpe?g|webp|gif)|[A-Za-z0-9_.-]+[.](png|jpe?g|webp|gif)|data:image/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+)( (https://firebasestorage[.]googleapis[.]com/v0/b/tashil-proptech-os[.](firebasestorage[.]app|appspot[.]com)/o/[^?# ]+([?][^# ]*)?|https://storage[.]googleapis[.]com/tashil-proptech-os[.](firebasestorage[.]app|appspot[.]com)/[^?# ]+|assets/[A-Za-z0-9_/.-]+[.](png|jpe?g|webp|gif)|[A-Za-z0-9_.-]+[.](png|jpe?g|webp|gif)|data:image/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+))*)?$')
        && !refs.matches('^.*[.][.].*$')
        && !refs.matches('(?i)^.*https://[^ ]*/(o/)?(users|private|kyc|documents|leases|contracts)(/|%2F).*$');
    }

    function imageListOk(list) {
      return list.size() <= 20 && imageRefsOk(list.join(' '));
    }

    // Value checks that match what sanitizeForMarketplace produces. Kept compact because a
    // request may evaluate at most 1000 rule expressions.
    function listingValuesOk(d) {
      let country = d.get('countryCode', 'EG');
      let currency = country == 'AE' ? 'AED' : 'EGP';
      let titles = d.get('titles', {});
      let descriptions = d.get('descriptions', {});
      let locations = d.get('locations', {});
      let amenities = d.get('amenitiesMap', {});
      let images = d.get('imageUrls', []);
      let image = d.get('image', '');
      // join() fails on non-string entries, which denies the write.
      let freeText = titles.values().concat(descriptions.values()).concat(locations.values())
        .concat(amenities.get('ar', [])).concat(amenities.get('en', [])).concat(amenities.get('hi', []))
        .concat([d.get('buildingName', ''), d.get('cityCode', ''), d.get('propertyTypeCode', '')])
        .join(' | ');
      return d.get('status', 'unavailable') in ['vacant', 'rented', 'unavailable']
        && country in ['EG', 'AE']
        && d.get('currencyCode', currency) == currency
        && d.get('is_published', false) is bool
        && d.get('isFeatured', false) is bool
        && d.get('isFurnished', false) is bool
        && inRange(d.get('rating', 0), 0, 5)
        && (d.get('is_published', false) == false || 'pricePerMonth' in d)
        && inRange(d.get('pricePerMonth', 1), 0.01, 1000000000)
        && inRange(d.get('areaSqM', 1), 0.01, 1000000)
        && inRange(d.get('bedrooms', 0), 0, 100)
        && inRange(d.get('bathrooms', 0), 0, 100)
        && titles.get('ar', '').size() <= 200 && titles.get('en', '').size() <= 200 && titles.get('hi', '').size() <= 200
        && descriptions.get('ar', '').size() <= 4000 && descriptions.get('en', '').size() <= 4000
        && descriptions.get('hi', '').size() <= 4000
        && locations.get('ar', '').size() <= 300 && locations.get('en', '').size() <= 300 && locations.get('hi', '').size() <= 300
        && d.get('buildingName', '').size() <= 200
        && d.get('cityCode', '').size() <= 60 && d.get('propertyTypeCode', '').size() <= 60
        && amenities.get('ar', []).size() <= 30 && amenities.get('en', []).size() <= 30 && amenities.get('hi', []).size() <= 30
        && contactFree(freeText)
        && image is string && !image.matches('^.* .*$') && imageRefsOk(image)
        && images is list && imageListOk(images)
        && d.get('agencyPhone', '').size() <= 30
        && (!('updated_at' in d) || d.updated_at is timestamp);
    }

    function listingShapeOk(propertyId) {
      let d = request.resource.data;
      return d.keys().hasOnly(publicListingFields())
        && d.get('id', propertyId) == propertyId
        && localizedKeysOk(d, 'titles')
        && localizedKeysOk(d, 'descriptions')
        && localizedKeysOk(d, 'locations')
        && localizedKeysOk(d, 'amenitiesMap')
        && listingValuesOk(d);
    }

    function ownsListing() {
      return isAuthenticated() && resource.data.get('owner_id', '') == request.auth.uid;
    }

    function agencyManagesResource() {
      return isAgencyAdminOf(resource.data.get('agency_id', ''));
    }

    match /Properties/{propertyId} {
      // Anyone (including unauthenticated visitors) can read published listings. Unpublished
      // ones, whatever their status, are visible only to their owner, agency, or SuperAdmin.
      allow read: if resource.data.get('is_published', false) == true
        || isSuperAdmin()
        || ownsListing()
        || agencyManagesResource();

      // Listings are written only by the syncOwnerPropertyToMarketplace trigger (Admin SDK)
      // from the owner's private Users/{ownerId}/properties tree, so no client can claim a
      // listing id before its owner publishes it. SuperAdmin keeps direct access for moderation.
      allow create, update: if isSuperAdmin() && listingShapeOk(propertyId);

      allow delete: if isSuperAdmin() || ownsListing() || agencyManagesResource();
    }

    // 3. Agencies Collection
    match /Agencies/{agencyId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAgencyAdmin() && request.auth.uid == agencyId);
    }

    // 4. Leases Collection
    // Lease documents are the server-side source of truth for reminder and invoice parties.
    match /Leases/{leaseId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (
          resource.data.tenant_id == request.auth.uid ||
          resource.data.owner_id == request.auth.uid ||
          agencyManagesResource()
        ));
      allow create: if isSuperAdmin() || isAgencyAdminOf(request.resource.data.get('agency_id', ''));
      allow update: if isSuperAdmin() || (
        agencyManagesResource() && !changedKeys().hasAny(['agency_id'])
      );
      allow delete: if isSuperAdmin() || agencyManagesResource();
    }

    // 5. Maintenance Requests
    match /Maintenance/{requestId} {
      allow read, write: if isAuthenticated();
    }
  }
}
