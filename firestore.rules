        && !l.matches('(?s)^.*(?:\\b(?:[iI][gG]|[iI][nN][sS][tT][aA]|[iI][nN][sS][tT][aA][gG][rR][aA][mM]|[tT][eE][lL][eE][gG][rR][aA][mM]|[tT][gG]|[wW][hH][aA][tT][sS][aA][pP][pP]|[wW][aA]|[sS][nN][aA][pP]|[sS][nN][aA][pP][cC][hH][aA][tT]|[tT][iI][kK][tT][oO][kK]|[tT][wW][iI][tT][tT][eE][rR]|[fF][bB]|[fF][aA][cC][eE][bB][oO][oO][kK]|[tT][hH][rR][eE][aA][dD][sS]|[yY][oO][uU][tT][uU][bB][eE]|[yY][tT]|[fF][oO][lL][lL][oO][wW]|[dD][mM])\\b|تابعنا|تابعونا|انستا|انستجرام|انستغرام|تليجرام|تيليجرام|تلجرام|واتساب|سناب|تيك توك|تويتر|فيسبوك)[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]*[\\x{3a}\\x{ff1a}][\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]*[A-Za-z][A-Za-z0-9._]*.*$')
        && !l.matches('(?s)^.*(?:\\b(?:[iI][gG]|[iI][nN][sS][tT][aA]|[iI][nN][sS][tT][aA][gG][rR][aA][mM]|[tT][eE][lL][eE][gG][rR][aA][mM]|[tT][gG]|[wW][hH][aA][tT][sS][aA][pP][pP]|[wW][aA]|[sS][nN][aA][pP]|[sS][nN][aA][pP][cC][hH][aA][tT]|[tT][iI][kK][tT][oO][kK]|[tT][wW][iI][tT][tT][eE][rR]|[fF][bB]|[fF][aA][cC][eE][bB][oO][oO][kK]|[tT][hH][rR][eE][aA][dD][sS]|[yY][oO][uU][tT][uU][bB][eE]|[yY][tT]|[fF][oO][lL][lL][oO][wW]|[dD][mM])\\b|تابعنا|تابعونا|انستا|انستجرام|انستغرام|تليجرام|تيليجرام|تلجرام|واتساب|سناب|تيك توك|تويتر|فيسبوك)[\\x{9}-\\x{d}\\x{20}\\x{a0}\\x{2000}-\\x{200a}\\x{202f}\\x{3000}]+[A-Za-z](?:[A-Za-z0-9]*[0-9]|[A-Za-z0-9._]*[._][A-Za-z0-9])[A-Za-z0-9._]*.*$');
    }
    // END GENERATED contact patterns

    // Emails: @ may be written [at], (at), {at} or full-width, with spaces around it, and
    // the dots as [dot]. `(?s)` lets `.` span newlines, so a later line is still checked.
    function contactFree(text) {
      return !contactPhone(text)
        && contactLinkFree(text)
        && !text.matches('(?s)^.*[A-Za-z0-9._%+Ａ-Ｚａ-ｚ０-９-][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*([@＠﹫]|[\\[({][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[Aa][Tt][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[\\])}])[\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[A-Za-z0-9Ａ-Ｚａ-ｚ０-９-]+(([.．]|[\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[\\[({][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[Dd][Oo][Tt][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[\\])}][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*)[A-Za-z0-9Ａ-Ｚａ-ｚ０-９-]+)*([.．]|[\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[\\[({][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[Dd][Oo][Tt][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*[\\])}][\\s\\x{00A0}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{3000}\\x{FEFF}]*)[A-Za-zＡ-Ｚａ-ｚ]{2,}.*$');
    }

    function inRange(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    // Space-separated image references: download URLs from this project's Storage bucket
    // (outside private folders), bundled assets, or inline raster images. Must match
    // isPublicImageRef() in backend/index.js.
    // The Firebase project id comes from the signed ID token's audience, so the allowed
    // buckets follow the project the rules are deployed to (prod keeps tashil-proptech-os).
    function projectId() {
      return request.auth.token.get('aud', '');
    }

    // Storage download URLs are accepted without a query or with `?alt=media` only: a `&token=`
    // URL is a bearer link Storage serves without storage.rules (sanitizeForMarketplace strips it).
    // The pattern is built once per check. Only the bucket name varies, so the static parts are
    // single literals: every string concatenation costs rule expressions.
    function imageRefPattern() {
      let bucket = projectId() + '[.](firebasestorage[.]app|appspot[.]com)';
      return '(https://firebasestorage[.]googleapis[.]com/v0/b/' + bucket + '/o/[^?# ]+([?]alt=media)?|https://storage[.]googleapis[.]com/'
        + bucket + '/[^?# ]+|assets/[A-Za-z0-9_/.-]+[.](png|jpe?g|webp|gif)|[A-Za-z0-9_.-]+[.](png|jpe?g|webp|gif)|data:image/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+)';
    }

    function imageRefsMatch(refs, ref) {
      return projectId().matches('[a-z][a-z0-9-]{4,29}') && imageRefsShapeOk(refs, ref);
    }

    // The project id is checked by the caller (once per request in listingEditOk).
    function imageRefsShapeOk(refs, ref) {
      return refs.matches('^(' + ref + '( ' + ref + ')*)?$')
        && !refs.matches('^.*[.][.].*$')
        && !refs.matches('(?i)^.*https://[^ ]*/(o/)?(users|private|kyc|documents|leases|contracts)(/|%2F).*$');
    }

    // Value checks that match what sanitizeForMarketplace produces. Kept compact because a
    // request may evaluate at most 1000 rule expressions.
    function listingValuesOk(d) {
      let country = d.get('countryCode', 'EG');
      let currency = country == 'AE' ? 'AED' : 'EGP';
      let titles = d.get('titles', {});
      let descriptions = d.get('descriptions', {});
      let locations = d.get('locations', {});
      let amenities = d.get('amenitiesMap', {});
      let images = d.get('imageUrls', []);
      let image = d.get('image', '');
      let ref = imageRefPattern();
      // join() fails on non-string entries, which denies the write. A spaced " | " is a list
      // break for the phone patterns, so digits in neighbouring fields never read as one number.
      let freeText = titles.values().concat(descriptions.values()).concat(locations.values())
        .concat(amenities.get('ar', [])).concat(amenities.get('en', [])).concat(amenities.get('hi', []))
        .concat(d.get('agencyNames', {}).values())
        .concat([d.get('buildingName', ''), d.get('cityCode', ''), d.get('propertyTypeCode', '')])
        .join(' | ');
      // keys() fails on anything that is not a map, which denies the write. One combined check keeps
      // each localized map to ar/en/hi.
      return titles.keys().concat(descriptions.keys()).concat(locations.keys()).concat(amenities.keys())
          .concat(d.get('agencyNames', {}).keys()).hasOnly(['ar', 'en', 'hi'])
        && d.get('status', 'unavailable') in ['vacant', 'rented', 'unavailable']
        && country in ['EG', 'AE']
        && d.get('currencyCode', currency) == currency
        && [d.get('is_published', false), d.get('isFeatured', false), d.get('isFurnished', false),
          d.get('verified', false), d.get('moderation_hidden', false)].hasOnly([true, false])
        && inRange(d.get('rating', 0), 0, 5)
        && (d.get('is_published', false) == false || 'pricePerMonth' in d)
        && inRange(d.get('pricePerMonth', 1), 0.01, 1000000000)
        && inRange(d.get('areaSqM', 1), 0.01, 1000000)
        && inRange(d.get('bedrooms', 0), 0, 100)
        && inRange(d.get('bathrooms', 0), 0, 100)
        && titles.get('ar', '').size() <= 200 && titles.get('en', '').size() <= 200 && titles.get('hi', '').size() <= 200
        && descriptions.get('ar', '').size() <= 4000 && descriptions.get('en', '').size() <= 4000
        && descriptions.get('hi', '').size() <= 4000
        && locations.get('ar', '').size() <= 300 && locations.get('en', '').size() <= 300 && locations.get('hi', '').size() <= 300
        && d.get('buildingName', '').size() <= 200
        && d.get('cityCode', '').size() <= 60 && d.get('propertyTypeCode', '').size() <= 60
        && amenities.get('ar', []).size() <= 30 && amenities.get('en', []).size() <= 30 && amenities.get('hi', []).size() <= 30
        && contactFree(freeText)
        && image is string && !image.matches('^.* .*$') && imageRefsMatch(image, ref)
        && images is list && images.size() <= 20 && !images.join(',').matches('(?s)^.* .*$') && imageRefsMatch(images.join(' '), ref)
        && agencyPhoneOk(d) && agencyNameSizesOk(d.get('agencyNames', {}))
        && d.get('agency_id', '').matches('^[A-Za-z0-9_-]{0,128}$')
        && (!('updated_at' in d) || d.updated_at is timestamp);
    }

    // Moderation state lives in PropertyModeration/{propertyId}, a document no owner can create,
    // change or delete, so it survives whatever happens to the public or the private listing doc.
    // A missing document means "not hidden". The public doc keeps `moderation_hidden` only as a
    // mirror for the UI; the rules below force it to equal the moderation doc.
    function moderationPath(propertyId) {
      return /databases/$(database)/documents/PropertyModeration/$(propertyId);
    }

    function propertyIdFreeFor(propertyId, uid) {
      return !exists(/databases/$(database)/documents/PropertyOwners/$(propertyId))
        || get(/databases/$(database)/documents/PropertyOwners/$(propertyId)).data.get('owner_id', '') == uid;
    }

    function listingModerationHidden(propertyId) {
      return exists(moderationPath(propertyId))
        && get(moderationPath(propertyId)).data.get('hidden', false) in [true, 'true'];
    }

    // A published listing that moderation holds hidden is not public, whatever the order the two
    // flags were written in. The string 'true' counts as hidden, as in storage.rules (TAQ-131).
    function publiclyVisible(d) {
      return d.get('is_published', false) == true
        && !(d.get('moderation_hidden', false) in [true, 'true']);
    }

    // True only when this very request also writes PropertyModeration/{propertyId}: the moderation
    // doc's updated_at is forced to request.time, which every write of one batch shares. A
    // visibility change that arrives on its own (no moderation write) therefore never passes.
    function moderationWrittenNow(propertyId) {
      return existsAfter(moderationPath(propertyId))
        && getAfter(moderationPath(propertyId)).data.get('updated_at', null) == request.time;
    }

    // Admin moderation of the public doc: verify it, hide it, or lift the hold. Any change to
    // is_published or moderation_hidden must come in the same batch as a PropertyModeration write,
    // and can only take the listing offline: no Admin or SuperAdmin write ever sets is_published
    // to true. Going back online is the server's job (reconcilePropertyModeration re-reads the
    // owner's private doc, rent and publish role), so a restore cannot republish a stale public
    // doc while the private one is unpublished or invalid or its owner lost the publish role.
    function adminModerationOk(propertyId) {
      let d = request.resource.data;
      return changedKeys().hasOnly(['is_published', 'verified', 'moderation_hidden', 'updated_at'])
        && [d.get('verified', false), d.get('moderation_hidden', false), d.get('is_published', false)].hasOnly([true, false])
        && (!('updated_at' in d) || d.updated_at == request.time)
        && (!changedKeys().hasAny(['is_published', 'moderation_hidden'])
          || adminVisibilityOk(propertyId));
    }

    function adminVisibilityOk(propertyId) {
      let d = request.resource.data;
      return moderationWrittenNow(propertyId)
        && d.get('moderation_hidden', false) == getAfter(moderationPath(propertyId)).data.get('hidden', false)
        && d.get('is_published', false) == false;
    }

    // A moderator writes exactly these four fields. Hiding records whether the public doc is
    // live right now (pre_hide_published), so a later restore cannot publish anything that was
    // not published before. Every later change keeps that stored value.
    function moderationDocShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['hidden', 'pre_hide_published', 'updated_by', 'updated_at'])
        && d.hidden is bool
        && d.pre_hide_published is bool
        && d.updated_by == request.auth.uid
        && d.updated_at == request.time;
    }

    function moderationHideOk(propertyId) {
      let d = request.resource.data;
      return d.hidden == true
        && exists(/databases/$(database)/documents/Properties/$(propertyId))
        && d.pre_hide_published
          == (get(/databases/$(database)/documents/Properties/$(propertyId)).data.get('is_published', false) == true);
    }

    // SuperAdmin content edits of an existing public doc (rating, featuring, verify, price, text,
    // images). A request may evaluate at most 1000 rule expressions and a full listing shape check
    // of a large listing alone uses almost all of them, so an update validates only the keys it
    // changes, using the diff, and trusts the rest of the stored doc. Visibility (is_published,
    // moderation_hidden), the id and the owner are not editable here: visibility goes through the
    // moderation path above, and the owner stays what the private doc said when the listing was made.
    function listingEditableKeys() {
      return [
        'agency_id', 'countryCode', 'currencyCode',
        'titles', 'descriptions', 'locations', 'cityCode', 'propertyTypeCode', 'buildingName',
        'pricePerMonth', 'bedrooms', 'bathrooms', 'areaSqM', 'image', 'imageUrls',
        'amenitiesMap', 'isFurnished', 'agencyNames', 'agencyPhone', 'rating', 'isFeatured',
        'status', 'updated_at', 'verified'
      ];
    }

    // agencyNames: a localized map of display names, like titles (string values, 200 chars at most,
    // contact-free through the free-text check). agencyPhone is the one phone number a listing may
    // carry, so it is checked for shape instead: phone characters only, 30 at most.
    function agencyNameSizesOk(names) {
      return names.get('ar', '').size() <= 200 && names.get('en', '').size() <= 200 && names.get('hi', '').size() <= 200;
    }

    function agencyPhoneOk(d) {
      return d.get('agencyPhone', '') is string && d.get('agencyPhone', '').matches('^[0-9+() .-]{0,30}$');
    }

    // A SuperAdmin create needs the private doc of the doc's own owner_id, and a public doc created
    // live (is_published true) must mirror a private listing its owner has published and left
    // available, as publishDecision does server-side (isPublished, rentalStatus). Anything else can
    // only be created unpublished. One get() serves both checks.
    function privateListingOk(propertyId) {
      let owner = request.resource.data.get('owner_id', '');
      let path = /databases/$(database)/documents/Users/$(owner)/properties/$(propertyId);
      return exists(path)
        && (request.resource.data.get('is_published', false) != true
          || (get(path).data.get('isPublished', false) == true && get(path).data.get('rentalStatus', 'available') == 'available'));
    }

    // An update that changes up to 6 keys validates only those keys (listingEditFieldsOk). Wider ones,
    // up to a full edit of every editable key, validate the whole resulting doc with the same
    // compact checks a create uses (listingValuesOk): measured on a maximum-size listing, the
    // per-field path costs more than the 1000-expression budget once enough text, image and
    // scalar keys change together, while the whole-doc check costs about the same however many do
    // (TAQ-105). The editable-key limit applies to both.
    // `c` is the changed-key set of this update. Fields it leaves out are not checked again, and
    // each stored value is read once into a local: every get() and string join costs expressions.
    function listingEditOk(c) {
      return c.hasOnly(listingEditableKeys())
        && ((c.size() <= 6 && listingEditFieldsOk(c))
          || (c.size() > 6 && listingValuesOk(request.resource.data)));
    }

    function listingEditFieldsOk(c) {
      let d = request.resource.data;
      let country = d.get('countryCode', 'EG');
      let currency = country == 'AE' ? 'AED' : 'EGP';
      let titles = d.get('titles', {});
      let descriptions = d.get('descriptions', {});
      let locations = d.get('locations', {});
      let amenities = d.get('amenitiesMap', {});
      let names = d.get('agencyNames', {});
      return (!('agency_id' in c) || (d.agency_id is string && d.agency_id.matches('^[A-Za-z0-9_-]{0,128}$')))
        && (!('status' in c) || d.get('status', '') in ['vacant', 'rented', 'unavailable'])
        && (!c.hasAny(['countryCode', 'currencyCode'])
          || (country in ['EG', 'AE'] && d.get('currencyCode', currency) == currency))
        && (!c.hasAny(['isFeatured', 'isFurnished', 'verified'])
          || [d.get('isFeatured', false), d.get('isFurnished', false), d.get('verified', false)].hasOnly([true, false]))
        && (!('rating' in c) || inRange(d.get('rating', 0), 0, 5))
        && (!('pricePerMonth' in c) || ('pricePerMonth' in d && inRange(d.pricePerMonth, 0.01, 1000000000)))
        && (!('areaSqM' in c) || inRange(d.get('areaSqM', 1), 0.01, 1000000))
        && (!('bedrooms' in c) || inRange(d.get('bedrooms', 0), 0, 100))
        && (!('bathrooms' in c) || inRange(d.get('bathrooms', 0), 0, 100))
        && (!('titles' in c) || ('titles' in d && localizedKeysOk(d, 'titles')
          && titles.get('ar', '').size() <= 200 && titles.get('en', '').size() <= 200 && titles.get('hi', '').size() <= 200))
        && (!('descriptions' in c) || (localizedKeysOk(d, 'descriptions')
          && descriptions.get('ar', '').size() <= 4000 && descriptions.get('en', '').size() <= 4000
          && descriptions.get('hi', '').size() <= 4000))
        && (!('locations' in c) || (localizedKeysOk(d, 'locations')
          && locations.get('ar', '').size() <= 300 && locations.get('en', '').size() <= 300 && locations.get('hi', '').size() <= 300))
        && (!('amenitiesMap' in c) || (localizedKeysOk(d, 'amenitiesMap')
          && amenities.get('ar', []).size() <= 30 && amenities.get('en', []).size() <= 30 && amenities.get('hi', []).size() <= 30))
        && (!('buildingName' in c) || d.get('buildingName', '').size() <= 200)
        && (!c.hasAny(['cityCode', 'propertyTypeCode'])
          || (d.get('cityCode', '').size() <= 60 && d.get('propertyTypeCode', '').size() <= 60))
        && (!('agencyPhone' in c) || agencyPhoneOk(d))
        && (!('agencyNames' in c) || (localizedKeysOk(d, 'agencyNames') && agencyNameSizesOk(names)))
        && (!('updated_at' in c) || d.updated_at is timestamp)
        && editedImagesOk(d, c)
        && (!c.hasAny(['titles', 'descriptions', 'locations', 'amenitiesMap', 'agencyNames', 'buildingName', 'cityCode', 'propertyTypeCode'])
          || contactFree(listingEditedText(d, c, titles, descriptions, locations, amenities, names)));
    }

    // image and imageUrls share one pattern and one project check. An element of imageUrls holding
    // a space would read as two refs once the list is joined, so the list is also checked joined
    // with a comma, which adds no space of its own.
    function editedImagesOk(d, c) {
      let ref = c.hasAny(['image', 'imageUrls']) ? imageRefPattern() : '';
      return (!c.hasAny(['image', 'imageUrls']) || projectId().matches('[a-z][a-z0-9-]{4,29}'))
        && (!('image' in c) || (d.image is string && !d.image.matches('^.* .*$') && imageRefsShapeOk(d.image, ref)))
        && (!('imageUrls' in c) || (d.imageUrls is list && d.imageUrls.size() <= 20 && !d.imageUrls.join(',').matches('(?s)^.* .*$')
          && imageRefsShapeOk(d.imageUrls.join(' '), ref)));
    }

    // The free text of only the fields this update changed, joined with " | " (a list break for the
    // phone patterns) like listingValuesOk does for a whole listing.
    function listingEditedText(d, c, titles, descriptions, locations, amenities, names) {
      return (('titles' in c) ? titles.values() : [])
        .concat(('descriptions' in c) ? descriptions.values() : [])
        .concat(('locations' in c) ? locations.values() : [])
        .concat(('agencyNames' in c) ? names.values() : [])
        .concat(('amenitiesMap' in c)
          ? amenities.get('ar', []).concat(amenities.get('en', [])).concat(amenities.get('hi', []))
          : [])
        .concat([('buildingName' in c) ? d.get('buildingName', '') : '',
          ('cityCode' in c) ? d.get('cityCode', '') : '',
          ('propertyTypeCode' in c) ? d.get('propertyTypeCode', '') : ''])
        .join(' | ');
    }

    function listingShapeOk(propertyId) {
      let d = request.resource.data;
      return d.keys().hasOnly(publicListingFields())
        && d.get('id', propertyId) == propertyId
        && !(d.get('is_published', false) == true && d.get('moderation_hidden', false) == true)
        && listingValuesOk(d);
    }

    function ownsListing() {
      return isAuthenticated() && resource.data.get('owner_id', '') == request.auth.uid;
    }

    function agencyManagesResource() {
      return isAgencyAdminOf(resource.data.get('agency_id', ''));
    }

    // The role and the diff are each evaluated once: a full edit of a large listing needs most of
    // the 1000-expression budget for its own value checks (TAQ-105).
    function propertyUpdateOk(propertyId) {
      let role = currentRole();
      let c = changedKeys();
      return (role == 'SuperAdmin'
          && (c.hasAny(['is_published', 'moderation_hidden']) ? adminModerationOk(propertyId) : listingEditOk(c)))
        || (role == 'Admin' && adminModerationOk(propertyId));
    }

    match /Properties/{propertyId} {
      // Anyone (including unauthenticated visitors) can read published listings that moderation
      // does not hold hidden. Unpublished or hidden ones are visible only to their owner, agency,
      // or platform staff.
      allow get: if publiclyVisible(resource.data)
        || isPlatformStaff()
        || ownsListing()
        || agencyManagesResource();
      // Rules are not filters: a list rule that also tested moderation_hidden would refuse the
      // marketplace query (`is_published == true`) outright, and filtering on
      // `moderation_hidden == false` would drop public docs that lack the field. Lists therefore
      // check is_published only; no write can make a doc both published and hidden
      // (listingShapeOk on create, adminVisibilityOk on visibility changes, and the sync trigger,
      // which sets is_published = !moderation_hidden).
      allow list: if resource.data.get('is_published', false) == true
        || isPlatformStaff()
        || ownsListing()
        || agencyManagesResource();

      // Listings are written only by the syncOwnerPropertyToMarketplace trigger (Admin SDK)
      // from the owner's private Users/{ownerId}/properties tree, so no client can claim a
      // listing id before its owner publishes it. SuperAdmin keeps direct access for moderation.
      // A SuperAdmin create needs the owner's private doc to exist (the path is built from the
      // doc's own owner_id) and is refused while moderation holds the id hidden, so deleting a held
      // public doc cannot be followed by recreating it live.
      allow create: if isSuperAdmin()
        && !listingModerationHidden(propertyId)
        && privateListingOk(propertyId)
        && listingShapeOk(propertyId);
      // Visibility changes (is_published, moderation_hidden) by Admin or SuperAdmin take the
      // moderation path and are checked first. Every other SuperAdmin edit takes the cheap path
      // that validates only the changed keys.
      allow update: if isAuthenticated() && propertyUpdateOk(propertyId);

      // An owner may remove their own listing, except while moderation holds it hidden: deleting
      // the public doc must not be a way to lose that state.
      allow delete: if isSuperAdmin()
        || ((ownsListing() || agencyManagesResource()) && !listingModerationHidden(propertyId));
    }

    // 2b. Listing moderation state. Platform staff only; no owner, tenant or agency can create,
    // change or delete it (including creating it first for their own listing). Only SuperAdmin
    // can delete it. Admin writes stay limited to the four fields above.
    match /PropertyModeration/{propertyId} {
      allow read: if isPlatformStaff();
      allow create: if isPlatformStaff() && moderationDocShapeOk() && moderationHideOk(propertyId);
      allow update: if isPlatformStaff() && moderationDocShapeOk()
        && (resource.data.get('hidden', false) == true || request.resource.data.hidden == false
          ? request.resource.data.pre_hide_published == resource.data.get('pre_hide_published', false)
          : moderationHideOk(propertyId));
      allow delete: if isSuperAdmin();
    }

    // 3. Agencies Collection
    // The agency document is a public profile. Contact details, licence, bank and staff data
    // belong in Agencies/{agencyId}/private/*.
    function publicAgencyFields() {
      return [
        'name', 'names', 'logo', 'logoUrl', 'orn', 'rera', 'city', 'cityCode', 'countryCode',
        'area', 'about', 'website', 'verified_badge', 'updated_at'
      ];
    }

    function canManageAgency(agencyId) {
      return isSuperAdmin() || isAgencyAdminOf(agencyId);
    }

    match /Agencies/{agencyId} {
      allow read: if true;
      allow create: if canManageAgency(agencyId)
        && request.resource.data.keys().hasOnly(publicAgencyFields())
        && (isSuperAdmin() || !('verified_badge' in request.resource.data))
        && request.resource.data.get('verified_badge', false) is bool;
      allow update: if canManageAgency(agencyId)
        && request.resource.data.keys().hasOnly(publicAgencyFields())
        && (isSuperAdmin() || !changedKeys().hasAny(['verified_badge']))
        && request.resource.data.get('verified_badge', false) is bool;
      allow delete: if canManageAgency(agencyId);

      match /private/{docId} {
        allow read, write: if canManageAgency(agencyId);
      }
    }

    // 4. Leases Collection
    // Lease documents are the server-side source of truth for reminder and invoice parties.
    // Statuses: draft, pending_tenant_approval, active, expired, terminated, rejected.
    // Leases are created by the createLease / createLeaseFromApplication functions (Admin SDK),
    // which check that the property belongs to the owner and that the agency manages it. The only
    // client create left is SuperAdmin's break-glass, and only as a draft or offer with valid rent
    // and dates. No client, SuperAdmin included, ever writes `active`: a lease becomes active only
    // in respondToLeaseOffer, under the property lock (PropertyLeaseLocks). Lifecycle: the owner or
    // managing agency moves draft -> pending_tenant_approval (and may pull it back to draft or
    // terminate it); the tenant may reject a pending offer; active -> expired | terminated.
    // expired, terminated and rejected are final. Rent, dates and the rest of the terms are editable
    // only while the lease is a draft, so the tenant approves exactly what they saw. tenant_id,
    // owner_id, agency_id and property_id never change after creation, for anyone.
    function leaseAmountOk(v) {
      return v is number && v > 0 && v <= 1000000000;
    }

    function leaseOptionalAmountOk(d, key) {
      return !(key in d) || leaseAmountOk(d[key]);
    }

    // Every rent field a lease carries is a finite number > 0 (NaN and Infinity fail both bounds).
    function leaseRentOk(d) {
      return leaseOptionalAmountOk(d, 'monthly_rent')
        && leaseOptionalAmountOk(d, 'annual_rent')
        && leaseOptionalAmountOk(d, 'baseAmount')
        && (!('financialTerms' in d)
          || (d.financialTerms is map
            && d.financialTerms.keys().hasOnly(['monthlyRent', 'annualRent'])
            && leaseOptionalAmountOk(d.financialTerms, 'monthlyRent')
            && leaseOptionalAmountOk(d.financialTerms, 'annualRent')));
    }

    function leaseHasRent(d) {
      return leaseAmountOk(d.get('monthly_rent', 0))
        || leaseAmountOk(d.get('annual_rent', 0))
        || ('financialTerms' in d && d.financialTerms is map
          && (leaseAmountOk(d.financialTerms.get('monthlyRent', 0)) || leaseAmountOk(d.financialTerms.get('annualRent', 0))));
    }

    function leaseDateOk(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function leaseDatesOk(d) {
      return leaseDateOk(d.get('start_date', null)) && leaseDateOk(d.get('end_date', null))
        && d.end_date > d.start_date;
    }

    // An offer the tenant can accept carries a positive rent and a valid date range.
    function leaseTermsOk(d) {
      return leaseRentOk(d) && leaseHasRent(d) && leaseDatesOk(d);
    }

    function leasePartiesOk(d) {
      return d.get('tenant_id', '') is string && d.get('tenant_id', '') != ''
        && d.get('owner_id', '') is string && d.get('owner_id', '') != ''
        && d.get('tenant_id', '') != d.get('owner_id', '')
        && d.get('property_id', '') is string && d.get('property_id', '') != ''
        && d.get('agency_id', '') is string;
    }

    function leaseCreateOk(d) {
      return leasePartiesOk(d)
        && d.get('status', '') in ['draft', 'pending_tenant_approval']
        && leaseTermsOk(d);
    }

    // Rules every lease update obeys, whoever writes it.
    function leaseUpdateInvariantsOk() {
      let before = resource.data.get('status', 'draft');
      let after = request.resource.data.get('status', 'draft');
      return !changedKeys().hasAny(['tenant_id', 'owner_id', 'agency_id', 'property_id'])
        && (after != 'active' || before == 'active')
        && (!changedKeys().hasAny(['monthly_rent', 'annual_rent', 'baseAmount', 'financialTerms'])
          || leaseRentOk(request.resource.data))
        && (!changedKeys().hasAny(['start_date', 'end_date']) || leaseDatesOk(request.resource.data))
        && (after != 'pending_tenant_approval' || before == 'pending_tenant_approval'
          || leaseTermsOk(request.resource.data));
    }

    function ownerManagesLease() {
      return isOwner()
        && resource.data.get('owner_id', '') == request.auth.uid
        && resource.data.get('agency_id', '') == '';
    }

    // Manager (owner or agency) status moves. Never to active or rejected: those are the tenant's.
    function leaseStatusMoveOk() {
      let from = resource.data.get('status', 'draft');
      let to = request.resource.data.get('status', 'draft');
      return to == from
        || (from == 'draft' && to in ['pending_tenant_approval', 'terminated'])
        || (from == 'pending_tenant_approval' && to in ['draft', 'terminated'])
        || (from == 'active' && to in ['expired', 'terminated']);
    }

    function leaseEditOk() {
      return leaseStatusMoveOk()
        && (resource.data.get('status', 'draft') == 'draft'
          || changedKeys().hasOnly(['status', 'notes', 'updated_at']));
    }

    // The tenant may reject a pending offer here; approving goes through respondToLeaseOffer.
    function tenantDecidesLease() {
      return isAuthenticated()
        && resource.data.get('tenant_id', '') == request.auth.uid
        && resource.data.get('owner_id', '') != request.auth.uid
        && resource.data.get('status', 'draft') == 'pending_tenant_approval'
        && request.resource.data.get('status', 'draft') == 'rejected'
        && changedKeys().hasOnly(['status', 'updated_at', 'tenant_decision_note'])
        && request.resource.data.get('tenant_decision_note', '') is string
        && request.resource.data.get('tenant_decision_note', '').size() <= 500;
    }

    match /Leases/{leaseId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (
          resource.data.tenant_id == request.auth.uid ||
          resource.data.owner_id == request.auth.uid ||
          agencyManagesResource()
        ));
      allow create: if isSuperAdmin() && leaseCreateOk(request.resource.data);
      allow update: if leaseUpdateInvariantsOk() && (
        isSuperAdmin()
        || ((agencyManagesResource() || ownerManagesLease()) && leaseEditOk())
        || tenantDecidesLease());
      // An active lease is ended (terminated / expired) before it can be deleted, except by SuperAdmin.
      allow delete: if isSuperAdmin()
        || (agencyManagesResource() && resource.data.get('status', 'draft') != 'active')
        || (ownerManagesLease() && resource.data.get('status', 'draft') == 'draft');
    }

    // 4a0. PropertyOwners (TAQ-110)
    // The one owner each property id belongs to, written only by the marketplace sync trigger
    // (first creator claims) and the dev backfill script. No client reads or writes it.
    match /PropertyOwners/{propertyId} {
      allow read, write: if false;
    }

    // 4a. PropertyLeaseLocks (TAQ-110)
    // One doc per property with a live lease, written only by respondToLeaseOffer and the payment
    // functions (Admin SDK) and removed by releasePropertyLeaseLock. No client reads or writes it.
    match /PropertyLeaseLocks/{propertyId} {
      allow read, write: if false;
    }

    // 4a2. AdminAlerts (TAQ-110)
    // Server-written alerts for platform staff, e.g. a gateway charge for an already paid month
    // that needs a refund. Read by platform staff only; no client writes.
    match /AdminAlerts/{alertId} {
      allow read: if isPlatformStaff();
      allow write: if false;
    }

    // 4b. Invoices
    // Written only by generateRentalInvoiceReceipt (Admin SDK), copying the lease parties.
    // Read only by those parties; clients never write, so a client cannot mint a receipt.
    match /Invoices/{invoiceId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (
          resource.data.get('tenant_id', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid ||
          agencyManagesResource()
        ));
      allow write: if false;
    }

    // 4b2. Transactions and PaymentSessions (TAQ-16)
    // Rent payments are written only by the payment functions (Admin SDK): pending by
    // createRentPaymentIntent, paid or failed by the signed Paymob webhook. The parties can read
    // them; no client can write one, so no client can make a payment look paid.
    // PaymentSessions hold the gateway checkout links (they carry the client secret): server only.
    match /Transactions/{transactionId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (
          resource.data.get('tenant_id', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid ||
          agencyManagesResource()
        ));
      allow write: if false;
    }

    match /PaymentSessions/{orderId} {
      allow read, write: if false;
    }

    // 4b3. Settings (TAQ-16)
    // Platform settings. Only SuperAdmin reads or writes them, and the only document is
    // payment_split: the platform and agency percentages the payment functions apply (the owner
    // gets the rest). The functions read it with the Admin SDK when they create a payment.
    function paymentSplitOk(d) {
      return d.keys().hasOnly(['platform_percent', 'agency_percent', 'updated_by', 'updated_at'])
        && d.keys().hasAll(['platform_percent', 'agency_percent', 'updated_by', 'updated_at'])
        && d.platform_percent is number && d.agency_percent is number
        && d.platform_percent >= 0 && d.agency_percent >= 0
        && d.platform_percent + d.agency_percent <= 100
        && d.updated_by == request.auth.uid
        && d.updated_at == request.time;
    }

    match /Settings/{settingId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && settingId == 'payment_split' && paymentSplitOk(request.resource.data);
      allow delete: if false;
    }

    // 4c. Telemetry_Crashes
    // Visitor crash reports from the web app: create-only, fixed keys, bounded sizes, no PII
    // beyond the caller's own uid. Only platform staff (SuperAdmin, Admin) can read them back.
    function crashReportOk(d) {
      return d.keys().hasOnly(['message', 'stack', 'context', 'isFatal', 'platform', 'uid', 'createdAt'])
        && d.keys().hasAll(['message', 'isFatal', 'platform', 'createdAt'])
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && d.get('stack', '') is string && d.get('stack', '').size() <= 8000
        && d.get('context', '') is string && d.get('context', '').size() <= 500
        && d.isFatal is bool
        && d.platform in ['web', 'android', 'iOS', 'macOS', 'windows', 'linux', 'fuchsia']
        && d.createdAt == request.time
        && (d.get('uid', null) == null
          || (isAuthenticated() && d.get('uid', null) is string && d.get('uid', null) == request.auth.uid));
    }

    match /Telemetry_Crashes/{crashId} {
      allow create: if crashId.size() <= 64 && crashReportOk(request.resource.data);
      allow get, list: if isPlatformStaff();
      allow update, delete: if false;
    }

    // 4d. AiRateLimits
    // Counters the geminiGenerate function keeps per signed-in user and per hashed visitor IP.
    // Only the Admin SDK writes them; no client may read or change its own quota.
    match /AiRateLimits/{bucketId} {
      allow read, write: if false;
    }

    // 4e. ViewingRequests and RentalApplications (TAQ-112)
    // Written only by the requestViewing / applyForRental / respond / decide / createLease functions
    // (Admin SDK): the listing must be live, the caller rate limited, and the owner and agency are
    // copied from the public listing. Readable by the signed-in requester, the owner, the managing
    // agency and platform staff. No client writes.
    match /ViewingRequests/{requestId} {
      allow read: if isPlatformStaff()
        || (isAuthenticated() && (resource.data.get('requester_id', '') == request.auth.uid
          || resource.data.get('owner_id', '') == request.auth.uid))
        || agencyManagesResource();
      allow write: if false;
    }

    match /RentalApplications/{applicationId} {
      allow read: if isPlatformStaff()
        || (isAuthenticated() && (resource.data.get('applicant_id', '') == request.auth.uid
          || resource.data.get('owner_id', '') == request.auth.uid))
        || agencyManagesResource();
      allow write: if false;
    }

    // 5. Maintenance Requests
    // Requests name their tenant, owner and agency. Parties and platform staff only; an
    // Investor (or any other signed-in user) has no access. Admin handles escalations by
    // changing the status or escalation fields, nothing else.
    function maintenanceParty() {
      return isAuthenticated() && (
        resource.data.get('tenant_id', '') == request.auth.uid ||
        resource.data.get('owner_id', '') == request.auth.uid ||
        agencyManagesResource()
      );
    }

    // A new request must name the lease it belongs to, and that lease must be active and link
    // exactly the tenant, owner and agency the request names. The caller must be that lease's
    // tenant or owner, so nobody can address a request to a party they have no lease with. One get()
    // on the lease.
    function maintenanceLinkedToLease() {
      let d = request.resource.data;
      let leaseId = d.get('lease_id', '');
      return leaseId is string && leaseId.size() > 0
        && exists(/databases/$(database)/documents/Leases/$(leaseId))
        && maintenanceMatchesLease(d, get(/databases/$(database)/documents/Leases/$(leaseId)).data);
    }

    function maintenanceMatchesLease(d, lease) {
      return d.get('tenant_id', '') is string && d.get('tenant_id', '') != ''
        && d.get('owner_id', '') is string && d.get('owner_id', '') != ''
        && d.get('tenant_id', '') == lease.get('tenant_id', '')
        && d.get('owner_id', '') == lease.get('owner_id', '')
        && d.get('agency_id', '') == lease.get('agency_id', '')
        && d.get('property_id', '') == lease.get('property_id', '')
        && d.get('property_title', '') == lease.get('property_title', '')
        && d.get('tenant_name', '') == lease.get('tenant_name', '')
        && lease.get('status', 'draft') == 'active'
        && (request.auth.uid == lease.get('tenant_id', '') || request.auth.uid == lease.get('owner_id', ''));
    }

    // A new request: a short title, an optional description, a category, at most three inline
    // photos, and always the pending status. Parties and lease are checked separately.
    // Inline photos: a base64 data URL of a raster image type, at most 300,000 characters each
    // (the limit the app enforces), so three fit well inside the 1 MiB document limit.
    function maintenancePhotoOk(photos, i) {
      return photos.size() <= i
        || (photos[i] is string && photos[i].size() <= 300000
          && photos[i].matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$'));
    }

    function maintenanceCreateShapeOk(d) {
      return d.keys().hasOnly(['lease_id', 'tenant_id', 'owner_id', 'agency_id', 'property_id', 'property_title',
          'tenant_name', 'title', 'description', 'category', 'photos', 'status', 'created_at', 'updated_at'])
        && d.get('tenant_name', '') is string && d.get('tenant_name', '').size() <= 100
        && d.get('property_title', '') is string && d.get('property_title', '').size() <= 200
        && d.get('title', '') is string && d.get('title', '').size() > 0 && d.get('title', '').size() <= 120
        && d.get('description', '') is string && d.get('description', '').size() <= 2000
        && d.get('category', 'other') in ['plumbing', 'electrical', 'ac', 'appliance', 'structural', 'cleaning', 'other']
        && d.get('photos', []) is list && d.get('photos', []).size() <= 3
        && maintenancePhotoOk(d.get('photos', []), 0)
        && maintenancePhotoOk(d.get('photos', []), 1)
        && maintenancePhotoOk(d.get('photos', []), 2)
        && d.get('status', '') == 'pending'
        && d.get('created_at', request.time) == request.time
        && d.get('updated_at', request.time) == request.time;
    }

    // The owner or the managing agency moves a request through its progress, and may add a note.
    function maintenanceProgressOk() {
      return changedKeys().hasOnly(['status', 'resolution_note', 'updated_at'])
        && request.resource.data.get('status', '') in ['pending', 'in_progress', 'resolved']
        && request.resource.data.get('resolution_note', '') is string
        && request.resource.data.get('resolution_note', '').size() <= 1000;
    }

    match /Maintenance/{requestId} {
      allow read: if isPlatformStaff() || maintenanceParty();
      allow create: if isSuperAdmin()
        || ((isTenant() || isOwner()) && maintenanceCreateShapeOk(request.resource.data) && maintenanceLinkedToLease());
      allow update: if isSuperAdmin()
        || (isAdmin() && changedKeys().hasOnly(['status', 'escalated', 'resolution_note', 'updated_at']))
        || ((isOwner() || isAgencyAdmin()) && maintenanceParty() && maintenanceProgressOk());
      allow delete: if isSuperAdmin() || (isAgencyAdmin() && agencyManagesResource());
    }
  }
}
