rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function selfServiceRoles() {
      return ['Owner', 'Tenant'];
    }

    function claimedRole() {
      return request.auth.token.get('role', '');
    }

    function profileRole() {
      let path = /databases/$(database)/documents/Users/$(request.auth.uid);
      return exists(path) ? get(path).data.get('role', '') : '';
    }

    // Elevated roles (SuperAdmin, AgencyAdmin) only come from a custom claim set by
    // the setUserRole callable or the Admin SDK. The profile document can only vouch
    // for self-service roles, so a role written into Users/{uid} never escalates.
    function currentRole() {
      return claimedRole() != ''
        ? claimedRole()
        : (profileRole() in selfServiceRoles() ? profileRole() : '');
    }

    function hasRole(role) {
      return isAuthenticated() && currentRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('SuperAdmin');
    }

    function isAgencyAdmin() {
      return hasRole('AgencyAdmin');
    }

    function isOwner() {
      return hasRole('Owner');
    }

    function isTenant() {
      return hasRole('Tenant');
    }

    function myAgencyId() {
      return request.auth.token.get('agency_id', '');
    }

    function isAgencyAdminOf(agencyId) {
      return isAgencyAdmin() && myAgencyId() != '' && agencyId == myAgencyId();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function addedOrChangedKeys() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // 1. Users Collection
    // Fields only the server (Admin SDK / setUserRole) may write. `role` is handled separately.
    function lockedUserFields() {
      return [
        'agency_id', 'agencyId', 'verified', 'isVerified', 'status', 'isSuperAdmin', 'customClaims', 'claims',
        'phone_verified', 'phoneVerified', 'kycStatus', 'kyc_status', 'account_status', 'accountStatus'
      ];
    }

    function selfUserCreate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'Owner') in selfServiceRoles()
        && !request.resource.data.keys().hasAny(lockedUserFields());
    }

    // A self-service role may be set once, only while the profile has none.
    function selfRoleChangeOk() {
      return !changedKeys().hasAny(['role'])
        || (resource.data.get('role', '') == ''
          && request.resource.data.get('role', '') in selfServiceRoles());
    }

    function selfUserUpdate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && !changedKeys().hasAny(lockedUserFields())
        && selfRoleChangeOk();
    }

    match /Users/{userId} {
      // Profiles hold national ID and bank details, so they are private to their owner.
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isSuperAdmin() || selfUserCreate(userId);
      allow update: if isSuperAdmin() || selfUserUpdate(userId);
      allow delete: if isSuperAdmin();

      // Dedicated Owner Properties Tree (Users/{userId}/properties/{propertyId})
      match /properties/{propertyId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      }

      // Written by Cloud Functions only.
      match /notifications/{notificationId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow write: if false;
      }
    }

    // 2. Properties Collection (Public Marketplace)
    // The only fields a public listing may carry. Must match sanitizeForMarketplace in
    // backend/index.js (plus agency_id attribution); anything else is rejected, so contact
    // fields such as phone, whatsapp, or email can never be written by a client.
    function publicListingFields() {
      return [
        'id', 'owner_id', 'agency_id', 'countryCode', 'currencyCode',
        'titles', 'descriptions', 'locations', 'cityCode', 'propertyTypeCode', 'buildingName',
        'pricePerMonth', 'bedrooms', 'bathrooms', 'areaSqM', 'image', 'imageUrls',
        'amenitiesMap', 'isFurnished', 'agencyNames', 'agencyPhone', 'rating', 'isFeatured',
        'is_published', 'status', 'updated_at'
      ];
    }

    // Contact details shown on the card; set only by the sync trigger or a SuperAdmin.
    function serverManagedListingFields() {
      return ['agencyNames', 'agencyPhone'];
    }

    function localizedKeysOk(data, field) {
      return !(field in data) || (data[field] is map && data[field].keys().hasOnly(['ar', 'en', 'hi']));
    }

    function listingShapeOk(propertyId) {
      let d = request.resource.data;
      return d.keys().hasOnly(publicListingFields())
        && d.get('id', propertyId) == propertyId
        && localizedKeysOk(d, 'titles')
        && localizedKeysOk(d, 'descriptions')
        && localizedKeysOk(d, 'locations')
        && localizedKeysOk(d, 'amenitiesMap');
    }

    function ownsListing() {
      return isAuthenticated() && resource.data.get('owner_id', '') == request.auth.uid;
    }

    function agencyManagesResource() {
      return isAgencyAdminOf(resource.data.get('agency_id', ''));
    }

    // Only landlords and agencies list properties. Must match PUBLISHER_ROLES in backend/authz.js.
    function canPublishListing() {
      return isOwner() || isAgencyAdmin();
    }

    function newListingAgencyOk() {
      return request.resource.data.get('agency_id', '') == ''
        || isAgencyAdminOf(request.resource.data.agency_id);
    }

    match /Properties/{propertyId} {
      // Anyone (including unauthenticated visitors) can read published listings. Unpublished
      // ones, whatever their status, are visible only to their owner, agency, or SuperAdmin.
      allow read: if resource.data.get('is_published', false) == true
        || isSuperAdmin()
        || ownsListing()
        || agencyManagesResource();

      // A listing is always created in the creator's own name.
      allow create: if isSuperAdmin() || (
        canPublishListing()
        && request.resource.data.get('owner_id', '') == request.auth.uid
        && newListingAgencyOk()
        && listingShapeOk(propertyId)
        && !request.resource.data.keys().hasAny(serverManagedListingFields())
      );

      // Ownership, agency attribution, and contact details cannot be changed by the client.
      allow update: if isSuperAdmin() || (
        canPublishListing()
        && (ownsListing() || agencyManagesResource())
        && !changedKeys().hasAny(['owner_id', 'agency_id'])
        && listingShapeOk(propertyId)
        && !addedOrChangedKeys().hasAny(serverManagedListingFields())
      );

      allow delete: if isSuperAdmin() || ownsListing() || agencyManagesResource();
    }

    // 3. Agencies Collection
    match /Agencies/{agencyId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAgencyAdmin() && request.auth.uid == agencyId);
    }

    // 4. Leases Collection
    // Lease documents are the server-side source of truth for reminder and invoice parties.
    match /Leases/{leaseId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && (
          resource.data.tenant_id == request.auth.uid ||
          resource.data.owner_id == request.auth.uid ||
          agencyManagesResource()
        ));
      allow create: if isSuperAdmin() || isAgencyAdminOf(request.resource.data.get('agency_id', ''));
      allow update: if isSuperAdmin() || (
        agencyManagesResource() && !changedKeys().hasAny(['agency_id'])
      );
      allow delete: if isSuperAdmin() || agencyManagesResource();
    }

    // 5. Maintenance Requests
    match /Maintenance/{requestId} {
      allow read, write: if isAuthenticated();
    }
  }
}
