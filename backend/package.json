{
  "name": "tashil-backend",
  "description": "Cloud Functions for TashilRealEstate",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore,auth --project demo-tashil-test 'npm run test:unit'",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js && node test_sync.js",
    "audit:roles": "node scripts/role_claims.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
