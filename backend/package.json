{
  "name": "tashil-backend",
  "description": "Cloud Functions for TashilRealEstate",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth --project demo-tashil-dev",
    "shell": "firebase functions:shell --project demo-tashil-dev",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project prod",
    "logs": "firebase functions:log --project prod",
    "test": "npm run test:core && npm run test:emulator",
    "test:core": "firebase emulators:exec --only firestore,auth,storage --project demo-tashil-test 'npm run test:unit'",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js && node test_sync.js",
    "test:emulator": "firebase emulators:exec --only functions,firestore,auth --project demo-tashil-test 'node --test --test-concurrency=1 test/emulator/*.smoke.js'",
    "seed": "node seed.js",
    "audit:roles": "node scripts/role_claims.js",
    "gen:contact-rules": "node scripts/generate_contact_rules.js",
    "check:client-keys": "node scripts/check_client_ai_keys.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
