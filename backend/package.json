{
  "name": "tashil-backend",
  "description": "Cloud Functions for TashilRealEstate",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:emulator": "node seed_emulator.js",
    "test:rules": "node --test test/rules.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "nodemailer": "^10.1.0"
  },
  "private": true
}
