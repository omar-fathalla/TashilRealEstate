# Non-secret Cloud Functions params, committed so `firebase deploy --only functions` runs
# without prompting. Every defineString/defineInt in backend/ needs a line here (a test checks).
# Never put a secret in this file: GEMINI_API_KEY lives in Secret Manager.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_BUDGET=0

# Paymob rent payments (TAQ-16). Off until the Paymob keys are set as secrets; see docs/SECURITY_SETUP.md.
# Never put PAYMOB_SECRET_KEY, PAYMOB_PUBLIC_KEY, PAYMOB_HMAC_SECRET or PAYMOB_INTEGRATION_ID here.
PAYMENTS_ENABLED=false
